diff --git a/application/rt-thread/helloworld/user_led/user_led.c b/application/rt-thread/helloworld/user_led/user_led.c
index 362ea37d..32d51f60 100644
--- a/application/rt-thread/helloworld/user_led/user_led.c
+++ b/application/rt-thread/helloworld/user_led/user_led.c
@@ -16,25 +16,41 @@
 #include <rtthread.h>
 #include "rtdevice.h"
 #include "aic_core.h"
+#include "aic_osal.h"
 #include "aic_hal_gpio.h"
 
 #define THREAD_PRIORITY         25     // 线程优先级，数字越大优先级越高
-#define THREAD_STACK_SIZE       512    // 线程堆栈大小，决定了线程可以使用的内存空间
+#define THREAD_STACK_SIZE       2048   // 线程堆栈大小
 #define THREAD_TIMESLICE        5      // 线程时间片，决定了线程在调度时能占用CPU的最长时间
 
 static rt_thread_t led_thread = RT_NULL; // 声明线程控制块指针，用于后续创建和管理线程
 static rt_base_t user_led_pin = RT_NULL; // 声明引脚编号变量，初始化为NULL，用于存储LED的引脚编号
 
-// 线程入口函数，这是线程启动后执行的函数
+/*
+ * Software PWM breathing light on PE17.
+ * 100 Hz carrier (20 ms), duty 0..100 % stepped by 2 %.
+ */
+static void user_led_pwm(int duty)
+{
+    if (duty > 0) {
+        rt_pin_write(user_led_pin, PIN_HIGH);
+        aicos_udelay(duty * 200);
+    }
+    rt_pin_write(user_led_pin, PIN_LOW);
+    if (duty < 100)
+        aicos_udelay((100 - duty) * 200);
+}
+
 static void user_led_thread_entry(void *param)
 {
-    while(1) // 无限循环，使线程持续运行
-    {
-        rt_pin_write(user_led_pin, PIN_HIGH); // 将LED引脚电平设置为高
-        rt_thread_mdelay(100); // 线程延时100毫秒，让LED保持高电平一段时间
+    int duty;
 
-        rt_pin_write(user_led_pin, PIN_LOW); // 将LED引脚电平设置为低
-        rt_thread_mdelay(100); // 线程延时100毫秒，让LED保持低电平一段时间
+    (void)param;
+    while (1) {
+        for (duty = 0; duty <= 100; duty += 2)
+            user_led_pwm(duty);
+        for (duty = 100; duty >= 0; duty -= 2)
+            user_led_pwm(duty);
     }
 }
 
